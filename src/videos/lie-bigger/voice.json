{
 "voice": "am_puck",
 "speed": 1.12,
 "lines": [
  {
   "i": 0,
   "text": "What if every lie... made you BIGGER?",
   "t0": 0.26666666666666666,
   "dur": 1.3457083333333333,
   "speed": 1.12
  },
  {
   "i": 1,
   "text": "Dad asked:",
   "t0": 5.266666666666667,
   "dur": 0.662375,
   "speed": 1.12
  },
  {
   "i": 2,
   "text": "Homework done?",
   "t0": 6.8,
   "dur": 0.7510416666666667,
   "speed": 1.12
  },
  {
   "i": 3,
   "text": "You said: YES.",
   "t0": 8.533333333333333,
   "dur": 0.7739166666666667,
   "speed": 1.12
  },
  {
   "i": 4,
   "text": "Who ate the last cookie?",
   "t0": 11.5,
   "dur": 1.0339166666666666,
   "speed": 1.12
  },
  {
   "i": 5,
   "text": "THE DOG.",
   "t0": 13.5,
   "dur": 0.5655416666666667,
   "speed": 1.12
  },
  {
   "i": 6,
   "text": "Your shirt got tight.",
   "t0": 15.166666666666666,
   "dur": 0.9128333333333334,
   "speed": 1.12
  },
  {
   "i": 7,
   "text": "Are you getting... bigger?",
   "t0": 17.066666666666666,
   "dur": 0.9251666666666667,
   "speed": 1.12
  },
  {
   "i": 8,
   "text": "NOPE.",
   "t0": 19.2,
   "dur": 0.48654166666666665,
   "speed": 1.12
  },
  {
   "i": 9,
   "text": "Your head hit the CEILING.",
   "t0": 20.666666666666668,
   "dur": 1.0207916666666668,
   "speed": 1.12
  },
  {
   "i": 10,
   "text": "Soon you didn't fit in the house.",
   "t0": 23.333333333333332,
   "dur": 1.264375,
   "speed": 1.12
  },
  {
   "i": 11,
   "text": "I'm totally FINE!",
   "t0": 26.066666666666666,
   "dur": 0.9001666666666667,
   "speed": 1.12
  },
  {
   "i": 12,
   "text": "The neighbors stared.",
   "t0": 28.2,
   "dur": 0.8652083333333334,
   "speed": 1.12
  },
  {
   "i": 13,
   "text": "Dad yelled: Just tell the truth!",
   "t0": 30.166666666666668,
   "dur": 1.3464166666666666,
   "speed": 1.12
  },
  {
   "i": 14,
   "text": "I ALWAYS tell the truth!",
   "t0": 32.266666666666666,
   "dur": 1.05875,
   "speed": 1.12
  },
  {
   "i": 15,
   "text": "Now you were above the CLOUDS.",
   "t0": 34.86666666666667,
   "dur": 1.2324583333333334,
   "speed": 1.12
  },
  {
   "i": 16,
   "text": "So you finally said it.",
   "t0": 37.166666666666664,
   "dur": 1.0271666666666666,
   "speed": 1.12
  },
  {
   "i": 17,
   "text": "I ate the cookie.",
   "t0": 39.6,
   "dur": 0.8237916666666667,
   "speed": 1.12
  },
  {
   "i": 18,
   "text": "No homework.",
   "t0": 41.666666666666664,
   "dur": 0.71225,
   "speed": 1.12
  },
  {
   "i": 19,
   "text": "I'm sorry, Dad.",
   "t0": 43.333333333333336,
   "dur": 0.8661666666666666,
   "speed": 1.12
  },
  {
   "i": 20,
   "text": "Dad smiled.",
   "t0": 46.333333333333336,
   "dur": 0.71975,
   "speed": 1.12
  },
  {
   "i": 21,
   "text": "See? Honesty is EASY.",
   "t0": 48.6,
   "dur": 1.1035,
   "speed": 1.12
  },
  {
   "i": 22,
   "text": "By the way... I LOVE your obby.",
   "t0": 51.0,
   "dur": 1.15275,
   "speed": 1.12
  },
  {
   "i": 23,
   "text": "...Uh-oh.",
   "t0": 54.666666666666664,
   "dur": 0.526125,
   "speed": 1.12
  }
 ],
